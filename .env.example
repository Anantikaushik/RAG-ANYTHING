# ============================================================
# RAG_ANYTHING - Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME=RAG_ANYTHING
APP_ENV=development
DEBUG=true


# ------------------------------------------------------------
# Graph Storage
# ------------------------------------------------------------

# Available backends:
#   memory
#   neo4j
#
# Use "memory" for tests / development without Neo4j.
# Use "neo4j" for persistent graph storage.

GRAPH_STORAGE_BACKEND=memory


# ------------------------------------------------------------
# Neo4j
# ------------------------------------------------------------

NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
NEO4J_DATABASE=rag-anything-db


# ------------------------------------------------------------
# Data Directories
# ------------------------------------------------------------

RAG_ANYTHING_DATA=D:\RAG_ANYTHING_DATA
UPLOAD_DIR=D:\RAG_ANYTHING_DATA\uploads
OUTPUT_DIR=D:\RAG_ANYTHING_DATA\outputs
STORAGE_DIR=D:\RAG_ANYTHING_DATA


# ------------------------------------------------------------
# Document Parsing
# ------------------------------------------------------------

# The ingestion layer uses MinerU as its unified parser for supported formats.
# Install MinerU separately with: pip install mineru
MINERU_HOME=D:\RAG_ANYTHING_DATA\mineru
MINERU_CONFIG=config/mineru.yaml
MINERU_OUTPUT_DIR=D:\RAG_ANYTHING_DATA\outputs
MINERU_STORAGE_DIR=D:\RAG_ANYTHING_DATA\uploads
HF_HOME=D:\RAG_ANYTHING_DATA\mineru\cache\huggingface
TEMP=D:\RAG_ANYTHING_DATA\mineru\temp
TMP=D:\RAG_ANYTHING_DATA\mineru\temp
MINERU_MIN_FREE_SPACE_MB=1024
MINERU_TIER=standard
MINERU_PARSE_MODE=auto
# Use the CPU path on systems where the local Vulkan/GPU runtime loses its device.
MINERU_DEVICE_MODE=cpu
# Limit each analysis window to one page to reduce peak image memory.
MINERU_PROCESSING_WINDOW_SIZE=1

DEFAULT_PARSER=mineru

# Maximum accepted document size.
MAX_FILE_SIZE_MB=100


# ------------------------------------------------------------
# Multimodal Processing
# ------------------------------------------------------------

ENABLE_IMAGE_PROCESSING=true
ENABLE_TABLE_PROCESSING=true
ENABLE_EQUATION_PROCESSING=true

# Groq vision model. Override when changing providers/models.
GROQ_VLM_MODEL=qwen/qwen3.6-27b


# ------------------------------------------------------------
# Knowledge Graph
# ------------------------------------------------------------

GRAPH_ENABLED=true

# Maximum graph traversal depth during retrieval.
GRAPH_MAX_DEPTH=3

# Entity and relationship extraction are disabled until
# the dedicated extraction layer is implemented.
GRAPH_ENABLE_ENTITY_EXTRACTION=false
GRAPH_ENABLE_RELATION_EXTRACTION=false


# ------------------------------------------------------------
# Retrieval
# ------------------------------------------------------------

# Number of top candidates returned by retrieval.
RETRIEVAL_TOP_K=10

# Fusion weights for vector and graph retrieval.
RETRIEVAL_VECTOR_WEIGHT=0.5
RETRIEVAL_GRAPH_WEIGHT=0.5


# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

LOG_LEVEL=INFO
LOG_DIR=data/storage/logs